# Copy to .env and adjust. Every value here has a working default, so `docker compose up` needs
# no edits at all — this file documents what can be changed, not what must be.
#
# Variables are namespaced `OPENPOSTURE_` so a container's environment cannot collide with ours.
# An unrecognised OPENPOSTURE_* variable is rejected at startup rather than ignored: a typo that
# leaves the service silently running on a default is the failure this naming exists to catch.

# development | test | production
# Production hides /docs and forces JSON logs.
OPENPOSTURE_ENVIRONMENT=development

# debug | info | warning | error | critical
OPENPOSTURE_LOG_LEVEL=info

# mediapipe | fake
# `fake` runs the entire application with no model at all — the whole stack starts and responds,
# with a fabricated skeleton. It is what CI and the container smoke test use, and it is how you
# work on the frontend without a 9 MB model or a 300 MB inference stack.
OPENPOSTURE_POSE_BACKEND=mediapipe

# straight | hunchback | reclined | kneeling | partial_occlusion | frontal_view | no_person
# Which scenario the fake backend returns. Ignored by mediapipe.
OPENPOSTURE_POSE_BACKEND_PRESET=straight

# local | s3
# `local` writes to a directory and needs nothing running. `s3` targets MinIO in development and
# any S3-compatible service in production; it arrives properly in Epic E.
OPENPOSTURE_STORAGE_BACKEND=local

# Where `local` storage writes. Inside the container this is a named volume, so uploads survive
# a restart without landing in your checkout.
OPENPOSTURE_STORAGE_ROOT=/app/var/storage

# --- database ---
#
# Async SQLAlchemy URL. Compose builds this from the POSTGRES_* service variables, so overriding
# it here is only needed when running the API on the host against the published port:
#
#   OPENPOSTURE_DATABASE_URL=postgresql+asyncpg://openposture:openposture-dev-only@localhost:5432/openposture
#
# Nothing connects until the first query, so an unreachable database is not a startup failure.
# As of OP-50 no route issues one; E5 is where that changes.
# OPENPOSTURE_DATABASE_URL=

# Connections held open per process, and the burst headroom above it. Postgres' own
# max_connections is the real ceiling: (pool + overflow) × number of API processes.
OPENPOSTURE_DATABASE_POOL_SIZE=5
OPENPOSTURE_DATABASE_MAX_OVERFLOW=5

# --- s3 storage (MinIO in development) ---
#
# Live as of OP-49. Compose passes these to the API unconditionally, so switching the whole
# stack to object storage is one edit: set OPENPOSTURE_STORAGE_BACKEND=s3 above. While the
# backend is `local` they are inert, because `S3Storage` is never constructed.
#
# The access key and secret default to the MinIO root credentials below, which is fine for a
# development stack and is not how a deployment should work: production wants a service account
# holding exactly the object permissions the API needs, and specifically *not* bucket creation.
# That is why the bucket is created by the `minio-init` one-shot rather than by the API.
OPENPOSTURE_S3_ENDPOINT_URL=http://minio:9000
OPENPOSTURE_S3_BUCKET=openposture

# --- backing services: deliberately not in this file ---
#
# Postgres and MinIO are configured by POSTGRES_*, MINIO_* and *_PORT variables, and those are
# documented in docker-compose.yml beside the services that consume them, not here.
#
# The reason is a trap worth naming, and it is not simply "the API ignores what isn't its own".
# `env_prefix` behaves differently for the two sources pydantic-settings reads:
#
#   * process environment variables — an unprefixed `POSTGRES_PORT` is ignored, as expected;
#   * this file — it is loaded whole and every key is validated against the model, so under
#     `extra="forbid"` an unprefixed key is a startup error, not a skipped one:
#
#         postgres_port
#           Extra inputs are not permitted [type=extra_forbidden, input_value='5432']
#
# `extra="forbid"` is what turns a misspelled OPENPOSTURE_ setting into a loud failure instead of
# a silently ignored one, and it cannot tell a typo from a Compose variable. Compose reads this
# same file, so an unprefixed key here breaks `uv run uvicorn ...` on the host for everyone who
# ran `cp .env.example .env`.
#
# So: if you need to override a service variable, add it to `.env` yourself and be aware that
# doing so is a Compose-only change. `5432` colliding with a Postgres you already run locally is
# the common case — `POSTGRES_PORT=5433` in `.env` fixes it, and the API is unaffected because
# it reaches the database over the compose network rather than through the published port.

# No ANTHROPIC_API_KEY here on purpose. LLM coaching is Epic F and is disabled by default, so a
# clean clone produces a working app with real posture analysis and no account to create.
