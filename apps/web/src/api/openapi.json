          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "severity": {
            "enum": [
              "major",
              "minor",
              "info"
            ],
            "title": "Severity",
