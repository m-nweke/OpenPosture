{
  "components": {
    "schemas": {
      "AnalysisDetail": {
        "additionalProperties": false,
        "description": "Full analysis record, returned by `GET /api/v1/analyses/{id}`.",
        "properties": {
          "assessed": {
            "title": "Assessed",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/StoredFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageSize"
          },
          "inference_ms": {
            "title": "Inference Ms",
            "type": "number"
          },
          "keypoints": {
            "items": {
              "$ref": "#/components/schemas/DetectedLandmark"
            },
            "title": "Keypoints",
            "type": "array"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/StoredMetric"
            },
            "title": "Metrics",
            "type": "array"
          },
          "object_key": {
            "title": "Object Key",
            "type": "string"
          },
          "overall_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall Score"
          },
          "pose_backend": {
            "title": "Pose Backend",
            "type": "string"
          },
          "pose_detected": {
            "title": "Pose Detected",
            "type": "boolean"
          },
          "rules_version": {
            "title": "Rules Version",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "created_at",
          "object_key",
          "pose_detected",
          "image",
          "overall_score",
          "assessed",
          "total",
          "inference_ms",
          "pose_backend",
          "rules_version",
          "schema_version",
          "keypoints",
          "metrics",
          "findings"
        ],
        "title": "AnalysisDetail",
        "type": "object"
      },
      "AnalysisListItem": {
        "additionalProperties": false,
        "description": "One row in the history list \u2014 enough to render a thumbnail row, nothing more.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "object_key": {
            "title": "Object Key",
            "type": "string"
          },
          "overall_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall Score"
          },
          "pose_detected": {
            "title": "Pose Detected",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "created_at",
          "object_key",
          "pose_detected",
          "overall_score"
        ],
        "title": "AnalysisListItem",
        "type": "object"
      },
      "AnalysisPage": {
        "additionalProperties": false,
        "description": "One page of the analysis history list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalysisListItem"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor to pass as `cursor` on the next request. `null` when this is the last page.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AnalysisPage",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "description": "What `POST /api/v1/analyses` returns on success.",
        "properties": {
          "id": {
            "description": "The analysis's database ID. Use this to retrieve or delete the record later. A UUID rather than an integer so that the presence of adjacent IDs is not leaked \u2014 a sequential key at `/analyses/41` implies `/analyses/40` belongs to somebody.",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageSize",
            "description": "The uploaded photograph's dimensions after EXIF rotation is applied \u2014 what the user actually sees. This is the authoritative size for a client; see the note on `PostureReportModel.image` for why the two can differ."
          },
          "landmarks": {
            "description": "Every landmark the backend returned, for drawing a skeleton over the photo. Empty when no pose was detected. The overlay is drawn client-side from these \u2014 the server never writes an annotated image, which would cost a round trip, storage for a derived artifact, and a cache-invalidation question every time the rules change.",
            "items": {
              "$ref": "#/components/schemas/DetectedLandmark"
            },
            "title": "Landmarks",
            "type": "array"
          },
          "object_key": {
            "description": "Where the uploaded image was stored. A key, never a URL \u2014 a URL embeds a host and an expiry, and persisting one means a hostname change invalidates it.",
            "title": "Object Key",
            "type": "string"
          },
          "pose_detected": {
            "title": "Pose Detected",
            "type": "boolean"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PostureReportModel"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` exactly when `pose_detected` is false."
          }
        },
        "required": [
          "id",
          "object_key",
          "pose_detected",
          "report",
          "landmarks",
          "image"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "Body_create_analysis_api_v1_analyses_post": {
        "properties": {
          "image": {
            "contentMediaType": "application/octet-stream",
            "description": "The photograph to analyse.",
            "title": "Image",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_create_analysis_api_v1_analyses_post",
        "type": "object"
      },
      "CredentialsRequest": {
        "additionalProperties": false,
        "description": "The body of `POST /auth/register` and `POST /auth/login`.\n\nOne model for both, because the two must validate identically. If registration accepted a\npassword that login rejected, an account could be created and never used again.",
        "properties": {
          "email": {
            "description": "Address to register or sign in with. Compared case-insensitively.",
            "format": "email",
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "At least 12 characters. Length is the only property checked \u2014 no character-class rule, which pushes people towards `Password1!` and away from a long passphrase.",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "CredentialsRequest",
        "type": "object"
      },
      "DetectedLandmark": {
        "additionalProperties": false,
        "description": "One measured point, in the form a client needs to draw it.\n\n**Normalised to the image, not in pixels.** The frontend renders the photo at whatever size\nthe viewport allows, so a pixel coordinate would be wrong the moment the layout changed. `x`\nand `y` are fractions of width and height, which stay correct under any scale \u2014 the same\nreasoning as the world-space metrics, applied to presentation.\n\nWorld coordinates are deliberately absent: they are metres from the hip and mean nothing on\na 2D canvas.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "presence": {
            "description": "[0, 1] \u2014 confidence the point is in frame at all.",
            "title": "Presence",
            "type": "number"
          },
          "status": {
            "description": "How usable this point is. A client must render anything other than `ok` distinctly or not at all \u2014 drawing a guessed position as though it were measured is the confident-wrong-answer failure this project exists to remove.",
            "enum": [
              "ok",
              "low_confidence",
              "not_detected",
              "out_of_frame"
            ],
            "title": "Status",
            "type": "string"
          },
          "visibility": {
            "description": "[0, 1] \u2014 confidence the point is not occluded.",
            "title": "Visibility",
            "type": "number"
          },
          "x": {
            "description": "Fraction of image width. May fall outside [0, 1].",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Fraction of image height, origin top-left.",
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "name",
          "x",
          "y",
          "status",
          "visibility",
          "presence"
        ],
        "title": "DetectedLandmark",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "description": "Something the engine noticed, already worded for a person.",
        "properties": {
          "code": {
            "description": "Stable identifier. Branch on this, not on `message`.",
            "title": "Code",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "severity": {
            "enum": [
              "major",
              "minor",
              "info"
            ],
            "title": "Severity",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "metric",
          "value",
          "confidence"
        ],
        "title": "Finding",
        "type": "object"
      },
      "Gap": {
        "additionalProperties": false,
        "description": "A metric that could not be assessed, and what stopped it.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "keypoints": {
            "additionalProperties": {
              "enum": [
                "ok",
                "low_confidence",
                "not_detected",
                "out_of_frame"
              ],
              "type": "string"
            },
            "title": "Keypoints",
            "type": "object"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "insufficient_keypoints",
              "low_confidence"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "metric",
          "status",
          "detail",
          "keypoints"
        ],
        "title": "Gap",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "Liveness. Deliberately has no field that could ever be false.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the running service.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "ImageSize": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "title": "Height",
