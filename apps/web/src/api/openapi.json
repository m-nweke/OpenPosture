          }
        },
        "required": [
          "width",
          "height"
        ],
        "title": "ImageSize",
        "type": "object"
      },
      "Metric": {
        "additionalProperties": false,
        "description": "One measurement, or an honest absence of one.",
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "detail": {
            "description": "Phrased for display by the engine, not by the client.",
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "insufficient_keypoints",
              "low_confidence"
            ],
            "title": "Status",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` whenever `status` is not `ok`. Never a guess \u2014 that is the point.",
            "title": "Value"
          }
        },
        "required": [
          "value",
          "unit",
          "status",
          "detail",
          "confidence"
        ],
        "title": "Metric",
        "type": "object"
      },
      "PostureReportModel": {
        "additionalProperties": false,
        "description": "One assessment of one photograph. Mirrors `PostureReport.to_dict()` exactly.",
        "properties": {
          "backend": {
            "title": "Backend",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "image": {
            "$ref": "#/components/schemas/ImageSize",
            "description": "The frame the *backend* measured, which is not always the frame that was uploaded. `FakePoseBackend` ignores the image entirely and reports its preset's own size, so this can differ from `AnalysisResponse.image` whenever the fake backend is in use. For anything to do with the uploaded photograph \u2014 scaling an overlay, for instance \u2014 use `AnalysisResponse.image`."
          },
          "inference_ms": {
            "title": "Inference Ms",
            "type": "number"
          },
          "metrics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Metric"
            },
            "title": "Metrics",
            "type": "object"
          },
          "overall_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 to 100, or `null` when nothing could be measured. Null rather than 0 or 100: both would be confident claims about a photograph the engine could not assess.",
            "title": "Overall Score"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "rules_version": {
            "title": "Rules Version",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "rules_version",
          "backend",
          "inference_ms",
          "image",
          "overall_score",
          "findings",
          "metrics",
          "quality"
        ],
        "title": "PostureReportModel",
        "type": "object"
      },
      "Quality": {
        "additionalProperties": false,
        "description": "How much of the body the engine could actually see.",
        "properties": {
          "assessed": {
            "title": "Assessed",
            "type": "integer"
          },
          "coverage": {
            "title": "Coverage",
            "type": "number"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/Gap"
            },
            "title": "Gaps",
            "type": "array"
          },
          "keypoints": {
            "additionalProperties": {
              "enum": [
                "ok",
                "low_confidence",
                "not_detected",
                "out_of_frame"
              ],
              "type": "string"
            },
            "title": "Keypoints",
            "type": "object"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "assessed",
          "total",
          "coverage",
          "gaps",
          "keypoints"
        ],
        "title": "Quality",
        "type": "object"
      },
      "Readiness": {
        "description": "Aggregate readiness: ready only when every registered check is.",
        "properties": {
          "checks": {
            "description": "One entry per registered subsystem, in registration order.",
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ReadinessCheck": {
        "description": "One subsystem's answer.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it is not ready. Omitted when it is.",
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ready"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "StoredFinding": {
