              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "insufficient_keypoints",
              "low_confidence"
            ],
            "title": "Status",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
