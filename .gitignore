# --- Python toolchain (OP-12: uv workspace) ---
# uv creates .venv/ at the workspace root. The pre-existing `venv/` entry does not match it.
.venv/
.python-version

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Coverage artefacts (the bare `coverage` entry above does not match these)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
*.egg-info/
build/
dist/

# --- Model weights (OP-20) ---
# Never committed. 9 MB is under GitHub's limit, but weights in git is how the legacy project
# ended up with a 209 MB blob it could not push and a Dropbox link instead. `make fetch-model`
# reproduces them from a pinned URL and verifies a pinned SHA256; models/checksums.txt is the
# thing under version control.
models/*.task
models/*.task.download

# A personal reading guide kept in the working tree, deliberately untracked. It is notes
# for one person rather than project documentation, and `git add -A` would otherwise sweep
# it into a commit.
OpenPosture-guided-tour.md
